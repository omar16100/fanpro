<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>pro.fanpro.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/sbin/fanprod</string>
  </array>

  <!--
    KeepAlive restarts the daemon if it exits. That matters more here than
    usual: this machine's firmware will not reclaim a fan left in manual
    mode, so a restarted daemon running its startup recovery is the only
    thing that frees a fan a crashed daemon left pinned.
  -->
  <key>KeepAlive</key>
  <true/>

  <key>RunAtLoad</key>
  <true/>

  <!--
    Restarts closer together than this are treated as a crash loop. The
    daemon notices the unclean-exit marker and latches itself into
    monitor-only mode rather than re-pinning the fans on every restart.
  -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <!--
    Interactive, not Background.  Background caps scheduling priority (PRI 4)
    and applies I/O throttling, and this daemon writes a history row on every
    recorded tick.  Its heartbeat watchdog (10 s by default) only raises a
    release request, which the control loop acts on when it next runs, so a
    loop starved of CPU is slow to hand the fans back; a thermal controller
    should not be competing for CPU on the machine it is protecting.

    Interactive rather than Adaptive: Adaptive promotion is driven by XPC
    activity and this server listens on a unix socket, so it would never be
    promoted.
  -->
  <key>ProcessType</key>
  <string>Interactive</string>

  <key>StandardErrorPath</key>
  <string>/var/log/fanpro/fanprod.err</string>
</dict>
</plist>
